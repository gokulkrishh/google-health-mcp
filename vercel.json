{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/healthz",
      "destination": "/api/mcp"
    },
    {
      "source": "/auth",
      "destination": "/api/mcp"
    },
    {
      "source": "/oauth2callback",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp"
    },
    {
      "source": "/authorize",
      "destination": "/api/mcp"
    },
    {
      "source": "/token",
      "destination": "/api/mcp"
    },
    {
      "source": "/register",
      "destination": "/api/mcp"
    }
  ]
}
